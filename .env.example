# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials. These are read only on the server by src/app/api/contact/route.js
# and are never exposed to the browser, which is why none of them carry the
# NEXT_PUBLIC_ prefix. Adding that prefix to any of these would inline the value
# into the client bundle.

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=dhatripatel67@gmail.com
