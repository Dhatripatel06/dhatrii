# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials. This file is TRACKED by git, so it must only ever hold empty
# placeholders; a value written here would be published on the next commit.
#
# These are read only on the server by src/app/api/contact/route.js and never
# reach the browser, which is why none carry the NEXT_PUBLIC_ prefix. Adding
# that prefix would inline the value into the client bundle.

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=dhatripatel67@gmail.com
